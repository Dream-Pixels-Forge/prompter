{
  "name": "prompter",
  "version": "0.1.0",
  "private": true,
  "description": "Floating prompt architect widget — transforms raw intent into structured prompts",
  "author": "Dream Pixels Forge <dev@dream-pixels-forge.com>",
  "license": "MIT",
  "homepage": "https://github.com/Dream-Pixels-Forge/prompter",
  "bugs": {
    "url": "https://github.com/Dream-Pixels-Forge/prompter/issues"
  },
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "lint:fix": "biome check --write --unsafe src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "pnpm build && electron-builder",
    "dist:mac": "pnpm build && electron-builder --mac",
    "dist:win": "pnpm build && electron-builder --win",
    "dist:linux": "pnpm build && electron-builder --linux"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.1.1",
  "dependencies": {
    "gsap": "^3.12.0",
    "lucide-react": "^0.400.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^39.8.0",
    "electron-builder": "^26.8.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vitest": "^4.1.7"
  }
}
